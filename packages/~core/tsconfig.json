{
  "extends": "tsconfig/base.json",
  "include": ["."],
  "compilerOptions": {
    "noEmit": true,
    "target": "ESNext",
    "module": "ESNext",
    "strictPropertyInitialization": false,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "verbatimModuleSyntax": true,
    "lib": ["ES2021", "ESNext", "DOM"],
    "types": ["bun-types", "elysia"]
  }
}
